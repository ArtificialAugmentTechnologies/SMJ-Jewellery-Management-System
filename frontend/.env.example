# SMJ Jewellery - FRONTEND environment variables (copy to frontend/.env)
# Only VITE_* variables are exposed to the browser. Never put secrets here.

# Leave empty for local development (Vite proxies /api to http://localhost:4000).
# Production: the full backend URL including /api, e.g. https://smj-api.onrender.com/api
VITE_API_URL=

# Store details printed on invoices
VITE_STORE_NAME="SMJ Jewellery"
VITE_STORE_ADDRESS=""
VITE_STORE_PHONE=""
VITE_STORE_EMAIL=""
VITE_STORE_GSTIN=""
