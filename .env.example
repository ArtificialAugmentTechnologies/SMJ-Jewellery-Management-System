# =====================================================================
# SMJ Jewellery - BACKEND environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env (it is git-ignored).
# =====================================================================

# Neon PostgreSQL connection string (Neon Console -> project -> Connect).
# Use the POOLED connection string and keep sslmode=verify-full.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/smj_jewellery_db?sslmode=verify-full&channel_binding=require"

# Long random secret used to sign login tokens (min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="12h"

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS).
# Production example: https://smj-jewellery.vercel.app
CORS_ORIGINS="http://localhost:5173"

# Admin mobile numbers allowed to sign in with mobile number + password + OTP
# (comma-separated, 10 digits). Leave empty to turn mobile sign-in off.
MOBILE_LOGIN_NUMBERS=""

# Number of reverse proxies in front of the API (1 on Render / Railway, 0 locally).
TRUST_PROXY=0
DB_POOL_MAX=10

# First administrator - used only by `npm run db:seed`.
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123"
